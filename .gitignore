# This is a Unity *package* root, not a project root.
# Project-level entries (/Library, /Temp, /Assets, ...) do not apply here.
# Based on https://github.com/github/gitignore/blob/main/Unity.gitignore
#
# Unity writes a .meta for every asset and they are part of the package.
# Never ignore them.

# Autogenerated VS / Rider / MD solution and project files
*.csproj
*.csproj.meta
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.DotSettings.user
ExportedObj/
.consulo/

# Meta files for the above
*.pidb.meta
*.pdb.meta
*.mdb.meta

# IDE / editor state
.vs/
.idea/
.vscode/
.gradle/

# OS generated files
.DS_Store
.DS_Store?
Thumbs.db

# Runtime artifacts
*.log
*.cache
*.tmp

# Unity crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.app
*.unitypackage
*.unitypackage.meta

# Crashlytics
crashlytics-build.properties
